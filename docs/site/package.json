{
  "name": "luna-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "python3 scripts/prepare-downloads.py && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check:links": "python3 scripts/check-links.py",
    "test:browser": "node scripts/check-site.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.7",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "~5.9.3"
  }
}
